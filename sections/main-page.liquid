{% unless page.handle == 'about-us' or template contains 'about-us' %}
<style>.page-title{margin-bottom:40px;}.main-content{padding:0;}</style>
<div class="container">
  <h1 class="text-center page-title">{{ page.title }}</h1>
  <div class="content-block--page">
    {{ page.content }}
  </div>
</div>
{% endunless %}
{% schema %}
{
  "name": " Page content Section",
  "tag": "section",
  "class": "spaced-section"
}
{% endschema %}
