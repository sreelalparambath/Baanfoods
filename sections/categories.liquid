<!-- categories.liquid -->
<div  class="customstyle{{ section.id }}">
    {%- include 'style-section' -%}
<div class="{{ section.settings.setwidth }}">
  <div class="section-block section-inner">
    {%- include 'section-heading' -%}
    <div class="category-wrapper dots-negative">
      {% assign carousel =  section.settings.enable_carousel %}
      {%- if section.settings.rows == '2' -%}
      {%- assign slidesToShow = section.blocks.size | divided_by:2 -%}
      {%- else -%}
      {%- assign slidesToShow = section.blocks.size -%}
      {%- endif -%}
      <div class="category-slider row mb-0" id="collection-list-{{ section.id }}"
           data-rows="1"
           data-slidesToShow="{{slidesToShow}}"
           data-slidestoscroll="1"
           data-arrows="{{ section.settings.arrows }}"
           data-dots="{{ section.settings.dots }}" 
           data-draggable="{{ section.settings.draggable }}" 
           data-infinite="{{ section.settings.infinite }}" 
           data-section-id="{{ section.id }}" 
           {% if carousel %}
           data-section-type="slickCarousels"
           {% endif %}>
        {%- for block in section.blocks -%}
        {%- assign category_url = block.settings.collection.url | default: '#' -%}
        <div class="{% if carousel %}  col {% else %} col-12 col-lg {% endif %} p-lg-0 category-item carousel__slide-wrapper--{{block.id}}" {{ block.shopify_attributes }}>
          
          <div class="category-item-image {% if block.settings.image != blank %} lazyload {% endif %} " 
          style="{% if block.settings.image != blank %}background-image:url({%- include 'srcBlank' -%}){% endif %}"
          {% if block.settings.image != blank %}data-bgset="{%- include 'bgset', image: block.settings.image -%}" data-sizes="auto"{% endif %}>
          {%- if block.settings.image == blank -%}
          <div class="placeholder-background">
            {%- capture current -%}{%- cycle 1, 2 -%}{%- endcapture -%}
            {{ 'lifestyle-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
          {%- endif -%}
            {% if block.settings.title !=blank %}
            <h4 class="text-capitalize my-3 h6" style="color:{{section.settings.title_cl}}">
              <a href="{{ category_url }}" style="color:inherit">{{ block.settings.title | default: block.settings.collection.title }}</a>
            </h4>
            {% endif %}
            {% if block.settings.description != blank %}<p class="baan-category-description">{{ block.settings.description }}</p>{% endif %}
            
            {% if block.settings.linklist !=blank %}
            <ul class="category-item-list list--no-bullets">
                {%- for link in linklists[block.settings.linklist].links -%}
                <li>
                <a href="{{link.url}}" title="{{link.title}}" style="color:{{section.settings.list_cl}}">
                    {{link.title | default:"Link"}}
                </a>
                </li>
                {% endfor %}
            </ul>
            {%- else -%}
            <ul class="category-item-list list--no-bullets">
              <li>
                <a href="{{ category_url }}" style="color:{{section.settings.list_cl}}">{{ block.settings.button_label }}</a>
              </li>
            </ul>
            {% endif %}
          </div>
        </div>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.blocks.size == 0 -%}
    {%- include 'no-blocks' -%}
    {%- endif -%}
  </div>
</div>
</div>

<style>
    
    @media (min-width:768px){
      .category-slider{
          margin: 0 calc(0px - var(--g-gutter));
      }
      .category-item:not(:last-child){
        border-right: 1px solid #e2e2e2;
      }
    }
    .category-item-image{
        background-position: bottom right;
        background-repeat: no-repeat;
        padding:0px 0 100px 30px;
    }
  .category-item-list li{position:relative;padding: 4px 0 4px 20px;}
  .category-item-list li:before{content:"\e904";position:absolute;left:0;top:8px;font-family: icomoon!important;color: var(--g-main);font-size: 10px;}
  .category-item-list a:hover{color:var(--color-accent-hover) !important; }

  .customstyle{{ section.id }} .section-inner{border-radius:22px;overflow:hidden;box-shadow:0 22px 60px rgba(67,16,12,.10)}
  .customstyle{{ section.id }} .section-title{color:#751610!important}
  .customstyle{{ section.id }} .category-slider{display:grid!important;grid-template-columns:repeat({{ section.settings.desktop_columns }},minmax(0,1fr));gap:{{ section.settings.card_gap }}px;margin:0!important;padding:0 30px 34px}
  .customstyle{{ section.id }} .category-item{width:auto!important;max-width:none!important;padding:0!important;border:0!important}
  .customstyle{{ section.id }} .category-item-image{position:relative;display:flex;min-height:{{ section.settings.card_height }}px;overflow:hidden;border-radius:{{ section.settings.card_radius }}px;padding:0 30px 30px;background-position:{{ section.settings.image_position }}!important;background-size:cover!important;flex-direction:column;justify-content:flex-end;isolation:isolate;box-shadow:0 14px 32px rgba(53,11,8,.18)}
  .customstyle{{ section.id }} .category-item-image:before{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(43,5,3,.02) 28%,rgba(45,7,4,.9) 100%)}
  .customstyle{{ section.id }} .category-item-image:after{content:"Authentic Baan Foods";position:absolute;top:24px;left:26px;padding:8px 13px;border:1px solid rgba(255,255,255,.55);border-radius:999px;background:rgba(77,12,8,.38);backdrop-filter:blur(8px);color:#fff;font-size:10px;font-weight:700;letter-spacing:.13em;text-transform:uppercase}
  .customstyle{{ section.id }} .category-item-image h4{position:relative;margin:0 0 10px!important;font-size:clamp(25px,2vw,34px)!important;line-height:1.1}
  .customstyle{{ section.id }} .category-item-image h4 a{color:#fff!important;text-shadow:0 2px 14px rgba(0,0,0,.35)}
  .customstyle{{ section.id }} .baan-category-description{position:relative;max-width:95%;margin:0 0 16px;color:rgba(255,255,255,.82);font-size:11px;line-height:1.55}
  .customstyle{{ section.id }} .category-item-list{position:relative;margin:0}
  .customstyle{{ section.id }} .category-item-list li{padding:0}
  .customstyle{{ section.id }} .category-item-list li:before{display:none}
  .customstyle{{ section.id }} .category-item-list a{display:inline-flex;align-items:center;padding:10px 17px;border:1px solid rgba(255,255,255,.6);border-radius:999px;color:#fff!important;font-size:12px;font-weight:700;transition:.25s ease}
  .customstyle{{ section.id }} .category-item-list a:hover{background:#fff;color:#751610!important}
  @media(max-width:991px){.customstyle{{ section.id }} .category-slider{grid-template-columns:1fr;padding:0 18px 24px}.customstyle{{ section.id }} .category-item-image{min-height:390px}}
</style>

