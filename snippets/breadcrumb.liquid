{%- if settings.enable_breadcrumb -%}
{% unless template == 'index' or template == 'cart' or template == 'list-collections' %}
<style>
  .g-breadcrumb{
    border-radius: 0;
    flex-direction: column;
    color:{{settings.color_breadcrumbs}} ;
    padding:20px 0;
    margin:0;
    background:{{settings.bg_breadcrumb}};}
  .g-breadcrumb a,.g-breadcrumb span{padding:0 3px;font-size:14px;line-height:20px;display:inline-block;}
  .g-breadcrumb a{
    color:{{settings.color_breadcrumbs_active}};
  }
  .g-breadcrumb .container,.g-breadcrumb .container-fluid{z-index: 2;position: relative;}
  .g-breadcrumb.breadcrumbs-style_2{
    min-height:270px;
    padding:72px 0;
    background-position:center 54%;
    background-repeat: no-repeat;
    background-size: cover;
    position: relative;
    border-radius: 0;
  }
  .template-product  .g-breadcrumb.breadcrumbs-style_2{
    min-height:210px;
    padding:52px 0;
  }
  @media (max-width:576px) {
    .g-breadcrumb.breadcrumbs-style_2{
      padding: 50px 0;
    }
    .g-breadcrumb.breadcrumbs-style_2 h3{
      font-size: 26px;
    }
  }
  .g-breadcrumb.breadcrumbs-style_2::before{
    background:linear-gradient(90deg,rgba(30,4,3,.90) 0%,rgba(46,7,4,.72) 34%,rgba(46,7,4,.22) 67%,rgba(46,7,4,.06) 100%);
    position: absolute;
    z-index: 1;
    content:"";
    left: 0;
    right: 0;
    bottom:0;
    top: 0;
  }
  .br-title{
    color:{{settings.color_breadcrumbs}}
  }
  .br-title svg{
    width: 23px;
    height: 23px;
  }
  .g-breadcrumb.breadcrumbs-style_2{display:flex;justify-content:center;box-shadow:inset 0 -1px rgba(117,22,16,.15)}
  .g-breadcrumb.breadcrumbs-style_2 .br-title{max-width:620px;color:#fff;font-size:clamp(36px,4vw,58px);font-weight:700;line-height:1.08;text-shadow:0 3px 22px rgba(0,0,0,.42)}
  .g-breadcrumb.breadcrumbs-style_2 a,.g-breadcrumb.breadcrumbs-style_2 span{color:#fff;text-shadow:0 2px 10px rgba(0,0,0,.42)}
  .g-breadcrumb.breadcrumbs-style_2 a{opacity:.78}
  @media(max-width:576px){.g-breadcrumb.breadcrumbs-style_2{min-height:190px;padding:42px 0;background-position:58% center}.g-breadcrumb.breadcrumbs-style_2::before{background:linear-gradient(90deg,rgba(30,4,3,.92),rgba(46,7,4,.52))}}

</style>
{%- assign page_handle = page.handle-%}
{%- assign listObject = settings.page_breadcrumb | split: ',' -%}

{%- capture checktagsother -%}
{%- for pagehandle in  listObject -%}
  {%- if page_handle contains pagehandle -%}
    {%- assign check_breadcrumb = "hide" | replace: ' ', '-' -%}
    {{check_breadcrumb}}
  {%- else -%}
   {%- assign check_breadcrumb = "true" | replace: ' ', '-' -%}
   {{check_breadcrumb}}
  {%- endif -%}
{%- endfor -%}
{%- endcapture -%}

{% assign bgimage = settings.img_breadcrumb %}
{% if template contains 'collection' and collection.handle %}
  {%- if collection.image.src != blank -%}
    {% assign bgimage = collection.image.src %}
  {%- else -%}
    {% assign bgimage = settings.img_breadcrumb %}
  {%- endif -%}
{% elsif template contains 'product' and collection.handle %}	
  {%- if collection.image.src != blank -%}
    {% assign bgimage = collection.image.src %}
  {%- else -%}
    {% assign bgimage = settings.img_breadcrumb %}
  {%- endif -%}
{% endif %}
<nav class="{{checktagsother}} breadcrumbs-{{settings.style_breadcrumb}} breadcrumb g-breadcrumb text-{{settings.align_bread}}" role="navigation" aria-label="breadcrumbs"
{% unless settings.style_breadcrumb == "style_1" %}style="background-image:url({{ 'baan-breadcrumb-premium-v1.png' | asset_url }})"{% endunless %}>
  <div class="{{settings.layout_bread}}">
  {% if settings.show_title_breadcumbs %}
    {% if template contains 'collection' and collection.handle %}
    <h3 class="mb-2 h2 br-title">{{ collection.title }}</h3>
    {% elsif template contains 'page' %}
    <h3 class="mb-2 h2 br-title">{% case template.suffix %}{% when 'shipping-policy' %}Shipping Policy{% when 'refund-policy' %}Refund Policy{% when 'terms-and-conditions' %}Terms and Conditions{% else %}{{ page.title }}{% endcase %}</h3>
    {% elsif template contains 'product' %}
      <h1 class="mb-2 br-title">{{ product.title }}</h1>
    {% elsif template contains 'blog' %}	
      <h3 class="mb-2 h2 br-title">{{ blog.title }}</h3>
    {% endif %}
  {% endif %}
  </div>
  <div class="{{settings.layout_bread}}">
    <a href="/" title="{{ 'general.breadcrumb.home' | t }}">{{ 'general.breadcrumb.home' | t }}</a>
    {% if template contains 'page' %}
    <span aria-hidden="true">/</span>
    <span>{% case template.suffix %}{% when 'shipping-policy' %}Shipping Policy{% when 'refund-policy' %}Refund Policy{% when 'terms-and-conditions' %}Terms and Conditions{% else %}{{ page.title }}{% endcase %}</span>
    {% elsif template contains 'product' %}
    {% if collection.url %}
    <span aria-hidden="true">/</span>
    {{ collection.title | link_to: collection.url }}
    {% endif %}
    <span aria-hidden="true">/</span>
    <span>{{ product.title }}</span>
    {% elsif template contains 'collection' and collection.handle %}
    <span aria-hidden="true">/</span>
    {% if current_tags %}
    {% capture url %}/collections/{{ collection.handle }}{% endcapture %}
    {{ collection.title | link_to: url }}
    <span aria-hidden="true">/</span>
    <span>{{ current_tags | join: " + " }}</span>
    {% else %}
    <span>{{ collection.title }}</span>
    {% endif %}
    {% elsif template == 'blog' %}
    <span aria-hidden="true">/</span>
    {% if current_tags %}
    {{ blog.title | link_to: blog.url }}
    <span aria-hidden="true">/</span>
    <span>{{ current_tags | join: " + " }}</span>
    {% else %}
    <span>{{ blog.title }}</span>
    {% endif %}
    {% elsif template == 'article' %}
    <span aria-hidden="true">/</span>
    {{ blog.title | link_to: blog.url }}
    <span aria-hidden="true">/</span>
    <span>{{ article.title }}</span>
    {% else %}
    <span aria-hidden="true">/</span>
    <span>{{ page_title }}</span>
    {% endif %}
  </div>
</nav>
{% endunless %}
{%- endif -%}
